# 배포용 설정. 이 파일을 같은 폴더에 .env 로 복사해 채운다 (cp .env.example .env)
# .env 는 git 에 올리지 않는다. 비밀값은 아래 명령으로 만든다
#   openssl rand -hex 32
# "$" 가 들어가는 값(비밀번호 해시 등)은 작은따옴표로 감싼다. 예: KEY='$2a$14$...'

# ===== 서버 주소 =====
# 서비스할 도메인. DNS A 레코드가 이 서버를 가리켜야 https 인증서가 발급된다
DOMAIN=dart.example.com
# 메일 속 링크·텔레그램 웹훅에 쓰는 주소. https://DOMAIN 과 같게
PUBLIC_URL=https://dart.example.com
# 같은 도메인으로 서비스하므로 비워 둔다 (다른 출처에서 API 를 부를 때만 쉼표로 나열)
ALLOWED_ORIGINS=
ENVIRONMENT=production

# ===== 비밀값 (반드시 바꿈) =====
# 링크 서명·세션용. openssl rand -hex 32
SECRET_KEY=change-me
# Postgres 비밀번호. 영문·숫자만 쓴다 (openssl rand -hex 24)
POSTGRES_PASSWORD=change-me

# ===== 로그인 =====
AUTH_REQUIRED=true
# 아무나 가입하지 못하게 하려면 false (계정은 dartrag user add 로 만듦)
ALLOW_SIGNUP=true
COOKIE_SECURE=true
SESSION_DAYS=30

# ===== OpenDART =====
# https://opendart.fss.or.kr 에서 발급
DART_API_KEY=
DART_MIN_INTERVAL=0.2
DART_DAILY_LIMIT=20000
DART_RESERVE=3000

# ===== 컨테이너 주소 =====
# 아래 넷은 docker-compose.yml 이 컨테이너 주소로 정해 준다. 여기 적어도 쓰이지 않는다
# DATABASE_URL=postgresql://dartrag:<POSTGRES_PASSWORD>@postgres:5432/dartrag
# REDIS_URL=redis://redis:6379/0
# QDRANT_URL=http://qdrant:6333
# OPENSEARCH_URL=http://opensearch:9200

# ===== 답변 생성 (Ollama) =====
# 기본: 서버에 직접 설치한 Ollama. ollama 프로필로 컨테이너를 띄우면 http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:8b

# ===== 검색 =====
EMBED_MODEL=BAAI/bge-m3
# 리랭커 (메모리 약 2.3GB 더 씀). 메모리가 부족하면 비워 두세요
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RECENCY_WEIGHT=0.1
EXPAND_CONTEXT=true
# OpenSearch 메모리 (서버 메모리가 넉넉하면 늘림)
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# ===== 답변 캐시 (Redis) =====
ANSWER_CACHE=true
SEMANTIC_CACHE=true
ANSWER_CACHE_TTL=604800

# ===== 원문 저장소 =====
# local: 서버 디스크(rawdata 볼륨), s3: S3 호환 저장소
RAW_STORE=local
S3_ENDPOINT_URL=
S3_BUCKET=dart-raw
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== 알림 =====
# 운영자용 웹훅 (Slack·Discord)
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 텔레그램 웹훅을 쓸 때만. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# ===== 메일 발송 (SMTP) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# 비밀번호 재설정·가입 인증·새 기기 로그인 알림 메일도 위 SMTP 로 보낸다 (링크는 PUBLIC_URL)
# 공개 서비스라면 true 로 두어 인증한 이메일만 알림을 켤 수 있게 한다
EMAIL_VERIFICATION_REQUIRED=true

# ===== 백그라운드 작업 (Celery) =====
FEED_POLL_MINUTES=10
INGEST_MINUTES=5
ALERTS_MINUTES=5
BACKFILL_ENABLED=false
BACKFILL_START_YEAR=2015
BACKFILL_BATCH=20
CONVERSATION_RETENTION_DAYS=180
# 정기 평가 (일요일 새벽, LLM 시간이 듦)
EVAL_SCHEDULE_ENABLED=false
EVAL_SCHEDULE_CASES=60

# ===== 요청 한도 (0 이면 끔) =====
RATE_ASK_PER_MINUTE=6
RATE_ASK_PER_DAY=200
RATE_HEAVY_PER_HOUR=10
RATE_AUTH_PER_HOUR=20

# ===== PDF 리포트 글꼴 =====
# 이미지에 나눔고딕이 들어 있고 기본값이 그 경로다. 바꿀 때만 채운다
# REPORT_FONT=/usr/share/fonts/truetype/nanum/NanumGothic.ttf

# ===== 운영 관측 =====
# /metrics 는 Caddy 가 바깥에서 막고 Prometheus 는 내부망으로 읽는다.
# 값을 넣으면 prometheus.prod.yml 에도 같은 토큰(authorization)을 넣어야 한다
METRICS_TOKEN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Langfuse 를 쓸 때만 (docs/deploy.md 의 "LLM 추적" 참고)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0
# 사용자·대화 번호는 SECRET_KEY 로 만든 가명으로만 보낸다. 탈퇴하면 그 가명의 추적 삭제를 요청
# (Langfuse 프로젝트 설정에서 데이터 보관 기간을 30일로 둘 것)
LANGFUSE_DELETE_ON_ACCOUNT_DELETE=true

# ===== 모니터링 (--profile monitoring) =====
# Grafana 자체 로그인 비밀번호
GRAFANA_ADMIN_PASSWORD=change-me
# https://DOMAIN/grafana/ 앞단 비밀번호. 해시는 아래 명령으로 만들고 작은따옴표로 감싼다
#   docker run --rm caddy:2.10.2 caddy hash-password
# 비워 두면 /grafana 에 아무도 들어갈 수 없다
GRAFANA_BASIC_AUTH_USER=admin
GRAFANA_BASIC_AUTH_HASH=

# ===== 백업 (infra/prod/backup.sh) =====
# 백업을 둘 폴더. 비우면 infra/prod/backups. 30일이 지난 것은 지운다
BACKUP_DIR=
# 넣으면 S3 에도 올린다 (서버에 aws cli 와 자격 증명이 있어야 함). 예: my-bucket/dartrag
BACKUP_S3_BUCKET=

# ===== 웹 푸시 알림 (선택, 무료) =====
# 키는 여기에 직접 쓰지 않는다. docs/deploy.md 의 "웹 푸시 알림" 명령이 이 파일 끝에
# VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY 두 줄을 붙인다. 키를 바꾸면 모든 사용자가 다시 구독해야 한다
# 푸시 서비스가 연락할 주소 (mailto:… 또는 https://…). 비우면 PUBLIC_URL
VAPID_SUBJECT=

# ===== 2단계 인증 =====
# 설정할 것은 없다 (사용자가 계정 화면에서 켠다). 인증 앱 키를 SECRET_KEY 로 암호화해 두므로
# SECRET_KEY 를 바꾸면 2단계 인증을 켠 사용자는 복구 코드로 로그인해 다시 켜야 한다
