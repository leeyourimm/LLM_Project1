# https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

DATABASE_URL=postgresql://dartrag:dartrag@localhost:5432/dartrag

# 원문 저장소: local 또는 s3 (S3 호환 저장소)
RAW_STORE=local
RAW_STORE_DIR=./data/raw
S3_ENDPOINT_URL=
S3_BUCKET=dart-raw
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenDART 호출 간격(초). 일일 한도를 넘지 않게 조절
DART_MIN_INTERVAL=0.2

# 검색 인덱스 (make up-search 로 띄움)
QDRANT_URL=http://localhost:6333
OPENSEARCH_URL=http://localhost:9200
EMBED_MODEL=BAAI/bge-m3
# 검색 결과 순서를 다시 매기는 리랭커 (약 2.3GB). 메모리가 부족하면 비워 두세요
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 답변 생성 (Ollama 로컬 모델)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
# 기본 모델이 실패하거나 첫 글자가 늦을 때 대신 답할 더 작은 모델 (미리 ollama pull). 비우면 안 씀
LLM_FALLBACK_MODEL=
# 대체 모델이 있을 때, 기본 모델의 첫 글자를 기다리는 시간(초)
LLM_FIRST_TOKEN_TIMEOUT=30
# 요청 하나의 최대 시간(초)과, 연결 실패·5xx 같은 일시적 오류에 다시 보낼 횟수
LLM_TIMEOUT=300
LLM_RETRIES=2

# 답변 캐시 (make up 으로 뜨는 Redis). 같은·비슷한 질문은 바로 답함
REDIS_URL=redis://localhost:6379/0
ANSWER_CACHE=true
SEMANTIC_CACHE=true

# 공시 알림 웹훅 (Slack·Discord). 비워 두면 터미널에만 출력
ALERT_WEBHOOK_URL=
# 나에게 텔레그램·이메일로도 보내려면 채웁니다
ALERT_TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=

# 텔레그램 봇 (텔레그램에서 @BotFather 에게 /newbot 으로 만든 토큰과 봇 아이디)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 공개 서버에서 웹훅을 쓸 때만. 아무 긴 문자열
TELEGRAM_WEBHOOK_SECRET=

# 메일 발송 (Gmail 이면 smtp.gmail.com, 587, 앱 비밀번호)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# 메일 속 링크에 쓰는 서비스 주소, 링크 서명용 비밀값 (python -c "import secrets;print(secrets.token_hex(32))")
PUBLIC_URL=http://127.0.0.1:8000
# 웹 화면(Next.js)을 따로 띄울 때 그 주소. 개발 서버는 http://localhost:3000
ALLOWED_ORIGINS=
SECRET_KEY=

# 로그인 (인터넷에 공개할 때만 켬). 내 컴퓨터에서만 쓰면 false 그대로 두세요
AUTH_REQUIRED=false
# 누구나 가입할 수 있게 할지. false 면 dartrag user add 로만 계정을 만듦
ALLOW_SIGNUP=true
# https 주소로 서비스할 때 true
COOKIE_SECURE=false
SESSION_DAYS=30
# 로그인 화면에 "가입 없이 체험하기"를 보일지. 체험 계정은 GUEST_HOURS 뒤 기록과 함께 지워진다
ALLOW_GUEST=false
GUEST_HOURS=24

# 백그라운드 작업자 (Celery). 주기는 분 단위
FEED_POLL_MINUTES=10
INGEST_MINUTES=5
# 새 정기보고서를 받아 색인할 회사. all: 모든 상장사, focus: 기본 15개사와 dartrag scope add 로 더한 회사
INDEX_SCOPE=all
ALERTS_MINUTES=5
# 관심 종목 회사의 기업 대시보드를 미리 만들어 두는 주기(분)와 캐시 보관 시간(초).
# 미리 만들기는 Redis 가 있을 때만 하고, 회사 데이터가 바뀌면 캐시 키가 바뀌어 새로 만든다
DASHBOARD_WARM_MINUTES=15
DASHBOARD_CACHE_TTL=21600
# 질문 화면의 예시 질문 (| 로 구분). 비워 두면 기본 예시 3개
EXAMPLE_QUESTIONS=
# 예시 질문의 답을 답변 캐시에 미리 넣는 주기(분). 데이터가 바뀐 것만 다시 넣고, 0 이면 끔
EXAMPLE_WARM_MINUTES=30
# 전체 상장사 과거 데이터 채우기. 켜면 하루 호출 한도 안에서 며칠에 걸쳐 진행
BACKFILL_ENABLED=false
BACKFILL_START_YEAR=2015
BACKFILL_BATCH=20
DART_DAILY_LIMIT=20000
DART_RESERVE=3000
# 대화 기록 보관 기간(일)
CONVERSATION_RETENTION_DAYS=180

# PDF 리포트 한글 글꼴(TTF 경로). 비우면 나눔고딕, 애플고딕, 맑은 고딕 순으로 찾는다
REPORT_FONT=

# --- 요청 한도 (사용자별, 로그인하지 않았으면 접속 주소별). 0 이면 끔 ---
RATE_ASK_PER_MINUTE=6
RATE_ASK_PER_DAY=200
RATE_HEAVY_PER_HOUR=10
RATE_AUTH_PER_HOUR=20
# 체험 계정: 만들기(접속 주소별), 질문·무거운 요청(위 한도에 더해 체험 계정이 쓰는 접속 주소별)
RATE_GUEST_PER_HOUR=5
RATE_GUEST_ASK_PER_MINUTE=2
RATE_GUEST_ASK_PER_DAY=20
RATE_GUEST_HEAVY_PER_HOUR=3

# --- 정기 평가 (일요일 새벽, LLM 시간이 꽤 듦) ---
EVAL_SCHEDULE_ENABLED=false
EVAL_SCHEDULE_CASES=60

# --- 운영 관측. 비워 두면 꺼짐 ---
ENVIRONMENT=development
# /metrics 를 보호하려면 값을 넣고 Prometheus 에도 같은 값을 준다
METRICS_TOKEN=
# 오류 수집 (pip install -e ".[ops]" 필요). 질문 내용·이메일·쿠키는 보내기 전에 지운다
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# LLM 추적. infra 의 langfuse 프로필을 띄웠다면 아래 값 그대로 쓰면 된다
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=pk-lf-dartrag-dev
LANGFUSE_SECRET_KEY=sk-lf-dartrag-dev
LANGFUSE_SAMPLE_RATE=1.0
# 사용자·대화 번호는 SECRET_KEY 로 만든 가명으로만 보낸다. 탈퇴하면 그 가명의 추적 삭제를 요청
# (Langfuse 프로젝트 설정에서 데이터 보관 기간을 30일로 둘 것)
LANGFUSE_DELETE_ON_ACCOUNT_DELETE=true

# --- 계정 메일 (로그인을 켰을 때만). 위의 SMTP_ 설정으로 보냅니다 ---
# 비밀번호 재설정·가입 이메일 인증·새 기기 로그인 알림. 메일 속 링크는 PUBLIC_URL 로 가므로
# 사용자가 여는 화면 주소를 넣으세요 (Next 개발 서버면 http://localhost:3000)
# true 면 가입한 이메일을 인증해야 이메일 알림을 켤 수 있습니다 (SMTP 가 없으면 적용 안 됨)
EMAIL_VERIFICATION_REQUIRED=false

# --- 웹 푸시 알림 (브라우저 알림, 무료. 로그인을 켰을 때만) ---
# 키는 `dartrag push keys` 가 만들어 아래 두 줄에 넣는다 (비밀키는 화면·로그에 나오지 않음)
# 비워 두면 웹 푸시를 쓰지 않는다. 키를 바꾸면 모든 사용자가 다시 구독해야 한다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 주소 (mailto:… 또는 https://…). 비우면 PUBLIC_URL
VAPID_SUBJECT=
# 2단계 인증은 사용자가 계정 화면에서 켠다. 인증 앱 키를 SECRET_KEY 로 암호화해 두므로
# SECRET_KEY 를 바꾸면 켠 사용자는 복구 코드로 로그인해 다시 켜야 한다
